# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- virtual environments ---
.venv/
venv/
env/

# --- data & model artifacts (large / regenerable, don't commit) ---
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

models/*
!models/.gitkeep

reports/figures/*
reports/metrics/*
!reports/figures/.gitkeep
!reports/metrics/.gitkeep

# --- notebooks checkpoints ---
.ipynb_checkpoints/
notebooks/*
!notebooks/.gitkeep

# --- env / secrets ---
.env
.env.*

# --- test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
