# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- virtual environments ---
.venv/
venv/
env/

# --- data & model artifacts (large / regenerable, don't commit) ---
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Trained model artifacts are small (tens of KB total) and required at
# runtime by the deployed API (see README's "Deploying to Render"
# section) — unlike data/ and reports/ above, these ARE committed.
# Allow only the known artifact files explicitly, not the whole
# directory, so a future large/binary model file doesn't get committed
# by accident.
models/*
!models/.gitkeep
!models/color_vocabulary.json
!models/co_occurrence.json
!models/color_embedding.json

reports/figures/*
reports/metrics/*
!reports/figures/.gitkeep
!reports/metrics/.gitkeep

# --- notebooks checkpoints ---
.ipynb_checkpoints/
notebooks/*
!notebooks/.gitkeep

# --- env / secrets ---
.env
.env.*

# --- test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
